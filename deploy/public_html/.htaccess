# LocalStorage - Hostgator (Apache)
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Todas las llamadas /api/... van al router PHP
  RewriteRule ^api/index\.php$ - [L]
  RewriteRule ^api/ api/index.php [L,QSA]
</IfModule>

# Forzar HTTPS: quita el "#" de las 2 líneas SOLO cuando el candado (AutoSSL) ya funcione
<IfModule mod_rewrite.c>
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Nunca servir archivos sensibles
<FilesMatch "(^config.*\.php$|\.sql$|\.md$|\.json$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
